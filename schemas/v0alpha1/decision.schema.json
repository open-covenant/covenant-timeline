{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covenant-timeline.org/schemas/v0alpha1/decision.schema.json",
  "title": "Timeline decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "kind", "policyDigest", "expiresAt"],
  "properties": {
    "schema": {
      "const": "covenant.timeline.decision.v0alpha1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "kind": {
      "enum": [
        "eligibility",
        "limit",
        "authority-recommendation",
        "authority-grant",
        "review",
        "pause",
        "deny"
      ]
    },
    "policyDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "scorecardRef": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "hardPolicyRef": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "expiresAt": {
      "$ref": "common.schema.json#/$defs/instant"
    },
    "limit": {
      "$ref": "common.schema.json#/$defs/quantity"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  }
}
