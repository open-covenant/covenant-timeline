{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covenant-timeline.org/schemas/v0alpha2/contract.schema.json",
  "title": "Timeline v0alpha2 contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "subject", "checkpoints"],
  "properties": {
    "schema": {
      "const": "covenant.timeline.contract.v0alpha2"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "subject": {
      "$ref": "common.schema.json#/$defs/subject"
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirements", "policy"],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/identifier"
            }
          },
          "policy": {
            "$ref": "common.schema.json#/$defs/policyBinding"
          },
          "onAccept": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "payloadRef"],
            "properties": {
              "kind": {
                "$ref": "common.schema.json#/$defs/identifier"
              },
              "payloadRef": {
                "$ref": "common.schema.json#/$defs/identifier"
              }
            }
          }
        }
      }
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  }
}
