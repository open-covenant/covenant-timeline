{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covenant-timeline.org/schemas/v0alpha1/contract.schema.json",
  "title": "Timeline contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "subject", "clocks", "checkpoints"],
  "properties": {
    "schema": {
      "const": "covenant.timeline.contract.v0alpha1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "subject": {
      "$ref": "common.schema.json#/$defs/subject"
    },
    "clocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/clock"
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "clock", "coordinate"],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "clock": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "coordinate": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["leftClock", "rightClock", "operator"],
        "properties": {
          "leftClock": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "rightClock": {
            "$ref": "common.schema.json#/$defs/identifier"
          },
          "operator": {
            "enum": ["before", "after", "equal", "within"]
          },
          "mapping": {
            "$ref": "common.schema.json#/$defs/identifier"
          }
        }
      }
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  }
}
