{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declarationMap": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "tsBuildInfoFile": "tsconfig.tsbuildinfo",
    "types": ["node"]
