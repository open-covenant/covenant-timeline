{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covenant-timeline.org/schemas/v0alpha3/contract.schema.json",
  "title": "Timeline v0alpha3 temporal contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "subject", "axes", "contexts"],
  "properties": {
    "schema": {
      "const": "covenant.timeline.contract.v0alpha3"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "subject": {
      "$ref": "common.schema.json#/$defs/subject"
    },
    "axes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/axis"
      }
    },
    "contexts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/context"
      }
    }
  }
}
