{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covenant-timeline.org/schemas/model-proposal/v1/proposal.schema.json",
  "title": "Covenant Timeline model proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "requestId", "changes", "query"],
  "properties": {
    "schema": {
      "type": "string",
      "enum": ["covenant.timeline.model-proposal.v1"]
    },
    "requestId": {
      "$ref": "#/$defs/identifier"
    },
    "changes": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "query": {
      "$ref": "#/$defs/queryIntent"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:/-]*$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "quote"],
      "properties": {
        "evidenceId": {
          "$ref": "#/$defs/identifier"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "supports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/support"
      }
    },
    "bounds": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["exact"]
            },
            "value": {
              "$ref": "#/$defs/safeInteger"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "minimum"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["lower-bound"]
            },
            "minimum": {
              "$ref": "#/$defs/safeInteger"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "maximum"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["upper-bound"]
            },
            "maximum": {
              "$ref": "#/$defs/safeInteger"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "minimum", "maximum"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["closed-range"]
            },
            "minimum": {
              "$ref": "#/$defs/safeInteger"
            },
            "maximum": {
              "$ref": "#/$defs/safeInteger"
            }
          }
        }
      ]
    },
    "revision": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["keep"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "assertionHandle"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["supersede"]
            },
            "assertionHandle": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      ]
    },
    "change": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "pointHandle", "bounds", "supports", "revision"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["coordinate"]
            },
            "pointHandle": {
              "$ref": "#/$defs/identifier"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "supports": {
              "$ref": "#/$defs/supports"
            },
            "revision": {
              "$ref": "#/$defs/revision"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "differenceHandle",
            "bounds",
            "supports",
            "revision"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["constraint"]
            },
            "differenceHandle": {
              "$ref": "#/$defs/identifier"
            },
            "bounds": {
              "$ref": "#/$defs/bounds"
            },
            "supports": {
              "$ref": "#/$defs/supports"
            },
            "revision": {
              "$ref": "#/$defs/revision"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "assertionHandle", "supports"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["retraction"]
            },
            "assertionHandle": {
              "$ref": "#/$defs/identifier"
            },
            "supports": {
              "$ref": "#/$defs/supports"
            }
          }
        }
      ]
    },
    "knowledgeCut": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["current"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "cutHandle"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["prior"]
            },
            "cutHandle": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      ]
    },
    "queryIntent": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "targetHandle", "knowledgeCut"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["consistency"]
            },
            "targetHandle": {
              "$ref": "#/$defs/identifier"
            },
            "knowledgeCut": {
              "$ref": "#/$defs/knowledgeCut"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "targetHandle", "knowledgeCut"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["difference"]
            },
            "targetHandle": {
              "$ref": "#/$defs/identifier"
            },
            "knowledgeCut": {
              "$ref": "#/$defs/knowledgeCut"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "targetHandle", "knowledgeCut"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["point-relation"]
            },
            "targetHandle": {
              "$ref": "#/$defs/identifier"
            },
            "knowledgeCut": {
              "$ref": "#/$defs/knowledgeCut"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "targetHandle", "knowledgeCut"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["interval-relation"]
            },
            "targetHandle": {
              "$ref": "#/$defs/identifier"
            },
            "knowledgeCut": {
              "$ref": "#/$defs/knowledgeCut"
            }
          }
        }
      ]
    }
  }
}
