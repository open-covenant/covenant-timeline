{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covenant-timeline.org/schemas/v0alpha1/event.schema.json",
  "title": "Timeline event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "sequence", "type"],
  "properties": {
    "schema": {
      "const": "covenant.timeline.event.v0alpha1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "enum": ["evidence.recorded", "checkpoint.evaluated", "receipt.recorded"]
    },
    "evidence": {
      "$ref": "evidence.schema.json"
    },
    "checkpointId": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      }
    },
    "policyRef": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "receipt": {
      "$ref": "receipt.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "evidence.recorded"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "evidence": {}
        },
        "required": ["evidence"]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "checkpoint.evaluated"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "checkpointId": {},
          "evidenceRefs": {},
          "policyRef": {}
        },
        "required": ["checkpointId", "evidenceRefs", "policyRef"]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "receipt.recorded"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "receipt": {}
        },
        "required": ["receipt"]
      }
    }
  ]
}
