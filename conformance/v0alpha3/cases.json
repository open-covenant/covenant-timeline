  {
    "id": "schema.valid-relation-conclusion",
    "targetSchema": "https://covenant-timeline.org/schemas/v0alpha3/conclusion.schema.json",
    "requirements": ["CTL3-CONCLUSION-001", "CTL3-PROOF-001"],
    "document": {
      "schema": "covenant.timeline.conclusion.v0alpha3",
      "queryId": "query.point-order",
      "result": {
        "type": "point.relations",
        "status": "resolved",
        "possible": ["before"]
      },
      "receipt": {
        "reasoner": "covenant.timeline.stn.v0alpha1",
        "stateDigest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "queryDigest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "semanticResultDigest": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
        "proof": {
          "kind": "relation-cases",
          "cases": [
            {
              "relation": "before",
              "possible": true,
              "witness": {
                "kind": "schedule",
                "coordinates": {
                  "review-start": 86400,
                  "deploy-start": 90000
                }
              }
            },
            {
              "relation": "equal",
              "possible": false,
              "witness": {
                "kind": "negative-cycle",
                "edges": [
                  {
                    "sourceId": "constraint.deploy-delay.v2",
                    "fromNodeId": "deploy-start",
                    "toNodeId": "review-start",
                    "maximum": -3600
                  },
                  {
                    "sourceId": "@query:query.point-order:equal:0",
                    "fromNodeId": "review-start",
                    "toNodeId": "deploy-start",
                    "maximum": 0
                  }
                ]
              }
            },
            {
              "relation": "after",
              "possible": false,
              "witness": {
                "kind": "negative-cycle",
                "edges": [
                  {
                    "sourceId": "constraint.deploy-delay.v2",
                    "fromNodeId": "deploy-start",
                    "toNodeId": "review-start",
                    "maximum": -3600
                  },
                  {
                    "sourceId": "@query:query.point-order:after:0",
                    "fromNodeId": "review-start",
                    "toNodeId": "deploy-start",
                    "maximum": -1
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "expect": {
      "valid": true
    }
  },
