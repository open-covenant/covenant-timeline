{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covenant-timeline.org/schemas/v0alpha1/evidence.schema.json",
  "title": "Timeline evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "claims", "payloadDigest", "producer"],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "kind": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      }
    },
    "payloadDigest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "producer": {
      "$ref": "common.schema.json#/$defs/identifier"
    }
  }
}
