{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covenant-timeline.org/schemas/v0alpha3/run.schema.json",
  "title": "Portable Timeline v0alpha3 temporal run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract", "events"],
  "properties": {
    "schema": {
      "const": "covenant.timeline.run.v0alpha3"
    },
    "contract": {
      "$ref": "contract.schema.json"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "event.schema.json"
      }
    }
  }
}
