{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covenant-timeline.org/schemas/mcp-real-model-pilot.v1.schema.json",
  "title": "Covenant Timeline maintainer-operated real-model pilot artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "operator",
    "operation",
    "provenance",
    "workflow",
    "inputDigest",
    "pilotInput",
    "run",
    "runDigest",
    "audit",
    "auditDigest",
    "admissionPolicy",
    "admissionPolicyDigest",
    "attemptLedger",
    "attemptLedgerDigest",
    "evidenceManifest",
    "modelConfig",
    "modelConfigDigest",
    "prompt",
    "promptDigest",
    "contentManifest",
    "phaseResults",
    "expected",
    "modelCalls",
    "conclusions",
    "invocations",
    "mcpInvocations",
    "source",
    "runtime",
    "runtimeDigest",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "covenant.timeline.real-model-pilot.artifact.v1"
    },
    "id": { "$ref": "v0alpha3/common.schema.json#/$defs/identifier" },
    "operator": { "type": "string", "minLength": 1, "maxLength": 128 },
    "operation": { "const": "maintainer-operated" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelExecution",
        "processRestart",
        "externalEvidenceAuthenticity",
        "mcpProcessIdentity"
      ],
      "properties": {
        "modelExecution": { "const": "maintainer-attested" },
        "processRestart": { "const": "maintainer-attested" },
        "externalEvidenceAuthenticity": {
          "const": "maintainer-attested"
        },
        "mcpProcessIdentity": {
          "const": "driver-observed-maintainer-attested"
        }
      }
    },
    "workflow": { "type": "string", "minLength": 1, "maxLength": 512 },
    "inputDigest": { "$ref": "v0alpha3/common.schema.json#/$defs/digest" },
    "pilotInput": { "const": "pilot-input.json" },
    "run": { "const": "run.json" },
    "runDigest": { "$ref": "v0alpha3/common.schema.json#/$defs/digest" },
    "audit": { "const": "audit.json" },
    "auditDigest": { "$ref": "v0alpha3/common.schema.json#/$defs/digest" },
    "admissionPolicy": { "const": "admission-policy.json" },
    "admissionPolicyDigest": {
      "$ref": "v0alpha3/common.schema.json#/$defs/digest"
    },
    "attemptLedger": { "const": "attempt-ledger.json" },
    "attemptLedgerDigest": {
      "$ref": "v0alpha3/common.schema.json#/$defs/digest"
    },
    "evidenceManifest": { "const": "evidence-manifest.json" },
    "modelConfig": { "const": "model-config.json" },
    "modelConfigDigest": {
      "$ref": "v0alpha3/common.schema.json#/$defs/digest"
    },
    "prompt": { "const": "prompt.md" },
    "promptDigest": { "$ref": "v0alpha3/common.schema.json#/$defs/digest" },
    "contentManifest": { "const": "content-manifest.json" },
    "phaseResults": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["phase", "path", "digest"],
          "properties": {
            "phase": { "const": "initial" },
            "path": { "const": "phase-results/initial.json" },
            "digest": {
              "$ref": "v0alpha3/common.schema.json#/$defs/digest"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["phase", "path", "digest"],
          "properties": {
            "phase": { "const": "correction" },
            "path": { "const": "phase-results/correction.json" },
            "digest": {
              "$ref": "v0alpha3/common.schema.json#/$defs/digest"
            }
          }
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tagCommit",
        "provisionalPublication",
        "authoritativePublication",
        "readinessRecorded",
        "initialDifference",
        "correctedDifference"
      ],
      "properties": {
        "tagCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "provisionalPublication": { "type": "integer" },
        "authoritativePublication": { "type": "integer" },
        "readinessRecorded": { "type": "integer" },
        "initialDifference": { "type": "integer" },
        "correctedDifference": { "type": "integer" }
      }
    },
    "modelCalls": {
      "type": "array",
      "prefixItems": [
        { "const": "model-calls/initial.json" },
        { "const": "model-calls/correction.json" }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "conclusions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "query", "conclusion"],
        "properties": {
          "name": { "enum": ["initial", "historical", "current"] },
          "query": { "type": "string", "pattern": "^queries/[a-z]+\\.json$" },
          "conclusion": {
            "type": "string",
            "pattern": "^conclusions/[a-z]+\\.json$"
          }
        }
      }
    },
    "invocations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phase", "invocationId", "processId"],
        "properties": {
          "phase": { "enum": ["initial", "correction"] },
          "invocationId": { "type": "string", "format": "uuid" },
          "processId": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "mcpInvocations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "invocationId",
          "processId",
          "provenance",
          "executableDigest",
          "script",
          "scriptDigest"
        ],
        "properties": {
          "phase": { "enum": ["initial", "correction"] },
          "invocationId": { "type": "string", "format": "uuid" },
          "processId": { "type": "integer", "minimum": 1 },
          "provenance": {
            "const": "driver-observed-maintainer-attested"
          },
          "executableDigest": {
            "$ref": "v0alpha3/common.schema.json#/$defs/digest"
          },
          "script": { "const": "packages/mcp-server/dist/cli.js" },
          "scriptDigest": {
            "$ref": "v0alpha3/common.schema.json#/$defs/digest"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty"],
      "properties": {
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "dirty": { "type": "boolean" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "profile",
        "node",
        "files",
        "packages",
        "resolutions"
      ],
      "properties": {
        "schema": {
          "enum": [
            "covenant.timeline.real-model-pilot.runtime.v1",
            "covenant.timeline.real-model-pilot.runtime.v2",
            "covenant.timeline.real-model-pilot.runtime.v3"
          ]
        },
        "profile": {
          "enum": ["formal-openai", "development-unbound-adapter"]
        },
        "node": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "modules",
            "v8",
            "platform",
            "arch",
            "executableDigest",
            "executableByteLength"
          ],
          "properties": {
            "version": { "type": "string", "minLength": 1, "maxLength": 64 },
            "modules": { "type": "string", "minLength": 1, "maxLength": 32 },
            "v8": { "type": "string", "minLength": 1, "maxLength": 64 },
            "platform": { "type": "string", "minLength": 1, "maxLength": 32 },
            "arch": { "type": "string", "minLength": 1, "maxLength": 32 },
            "executableDigest": {
              "$ref": "v0alpha3/common.schema.json#/$defs/digest"
            },
            "executableByteLength": {
              "type": "integer",
              "minimum": 1,
              "maximum": 268435456
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest", "byteLength"],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(?:packages/(?:prototype|mcp-server)/(?:package\\.json|dist/[a-zA-Z0-9._/-]+)|schemas/(?:mcp-real-model-pilot\\.v1\\.schema|v0alpha3/common\\.schema)\\.json|scripts/[a-zA-Z0-9._/-]+)$",
                "minLength": 1,
                "maxLength": 512
              },
              "digest": {
                "$ref": "v0alpha3/common.schema.json#/$defs/digest"
              },
              "byteLength": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16777216
              }
            }
          }
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "version",
              "digest",
              "fileCount",
              "byteLength"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^npm:[a-zA-Z0-9@._/-]+#[0-9a-f]{64}$",
                "maxLength": 256
              },
              "name": {
                "type": "string",
                "pattern": "^(?:@[a-z0-9._-]+/)?[a-z0-9._-]+$",
                "maxLength": 214
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "digest": {
                "$ref": "v0alpha3/common.schema.json#/$defs/digest"
              },
              "fileCount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "byteLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 134217728
              }
            }
          }
        },
        "resolutions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "specifier", "to"],
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^(?:application|npm:[a-zA-Z0-9@._/-]+#[0-9a-f]{64})$",
                "maxLength": 256
              },
              "specifier": {
                "type": "string",
                "pattern": "^(?:@[a-z0-9._-]+/)?[a-z0-9._-]+$",
                "maxLength": 214
              },
              "to": {
                "type": "string",
                "pattern": "^npm:[a-zA-Z0-9@._/-]+#[0-9a-f]{64}$",
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    "runtimeDigest": {
      "$ref": "v0alpha3/common.schema.json#/$defs/digest"
    },
    "limitations": {
      "type": "array",
      "contains": { "const": "not-independent-adoption" },
      "minItems": 1,
      "maxItems": 16,
      "items": { "type": "string", "minLength": 1, "maxLength": 128 }
    }
  }
}
