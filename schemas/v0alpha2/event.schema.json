{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covenant-timeline.org/schemas/v0alpha2/event.schema.json",
  "title": "Timeline v0alpha2 event",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "sequence", "type", "evidence"],
      "properties": {
        "schema": {
          "const": "covenant.timeline.event.v0alpha2"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "evidence.recorded"
        },
        "evidence": {
          "$ref": "evidence.schema.json"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "sequence",
        "type",
        "checkpointId",
        "evidenceRefs"
      ],
      "properties": {
        "schema": {
          "const": "covenant.timeline.event.v0alpha2"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "checkpoint.evaluated"
        },
        "checkpointId": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/identifier"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "sequence", "type", "receipt"],
      "properties": {
        "schema": {
          "const": "covenant.timeline.event.v0alpha2"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "const": "receipt.recorded"
        },
        "receipt": {
          "$ref": "receipt.schema.json"
        }
      }
    }
  ]
}
