{
  "name": "covenant-timeline",
  "version": "0.0.0",
  "private": true,
  "description": "Temporal reasoning research program and checkpoint verifier for AI systems.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": "^22.0.0 || ^24.0.0",
    "pnpm": ">=10.0.0 <11.0.0"
  },
  "scripts": {
    "boundary:check": "node scripts/check-boundaries.mjs",
    "build": "pnpm -r --if-present build",
    "clean": "pnpm -r --if-present clean",
    "conformance:check": "pnpm build && node scripts/check-conformance.mjs",
    "conformance:cross-check": "python3 scripts/check-jcs-python.py",
    "reducer:cross-check": "python3 scripts/check-python-reducer.py",
    "replay:benchmark": "pnpm build && node scripts/benchmark-replay.mjs",
    "coverage:check": "pnpm -r --if-present coverage",
    "demo": "pnpm build && node packages/prototype/dist/cli.js verify conformance/v0alpha1/runs/successful.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "github-profile:check": "pnpm build && node scripts/check-github-profile.mjs",
    "lint": "pnpm -r --if-present lint",
    "model-eval:run": "pnpm build && node scripts/run-model-interface-eval.mjs",
    "model-eval:score": "pnpm build && node scripts/score-model-interface-eval.mjs",
    "model-eval:openai-config": "node scripts/create-openai-model-eval-config.mjs",
    "model-eval:test": "pnpm build && node --test scripts/create-openai-model-eval-config.test.mjs scripts/model-interface-eval.test.mjs scripts/openai-responses-model-eval-adapter.test.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "public-runs:check": "pnpm build && node scripts/longitudinal-github-run.mjs verify --out examples/public-runs/temporal-sdk-typescript-pr-2219.json",
    "release:check": "node scripts/check-release.mjs",
    "release:evidence:check": "node scripts/check-release-evidence.mjs",
    "release:evidence:test": "node --test scripts/check-release-evidence.test.mjs",
    "release:verify-published": "node scripts/verify-published-release.mjs",
    "spec:check": "node scripts/check-spec.mjs",
    "test": "pnpm -r --if-present test",
    "timeline": "node packages/prototype/dist/cli.js",
    "temporal:benchmark": "pnpm build && node scripts/benchmark-temporal.mjs",
    "temporal:demo": "pnpm build && node examples/temporal-reasoning.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm format:check && pnpm boundary:check && pnpm spec:check && pnpm release:evidence:check && pnpm release:evidence:test && pnpm conformance:check && pnpm model-eval:test && pnpm github-profile:check && pnpm public-runs:check && pnpm lint && pnpm typecheck && pnpm coverage:check && pnpm pack:check"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jsonc-parser": "3.3.1",
    "prettier": "3.8.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.5"
  }
}
