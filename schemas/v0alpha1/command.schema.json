{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covenant-timeline.org/schemas/v0alpha1/command.schema.json",
  "title": "Timeline command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "payloadRef",
    "idempotencyKey",
    "replayPolicy"
  ],
  "properties": {
    "schema": {
      "const": "covenant.timeline.command.v0alpha1"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "kind": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "payloadRef": {
      "$ref": "common.schema.json#/$defs/identifier"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 8,
      "maxLength": 512
    },
    "replayPolicy": {
      "const": "forbid"
    }
  }
}
