{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covenant-timeline.org/benchmarks/model-proposal-boundary/v2/gate.schema.json",
  "title": "Covenant Timeline model-proposal reliability gate v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision",
    "claim",
    "checks",
    "failedChecks",
    "operationalErrors",
    "grounding",
    "bindings"
  ],
  "properties": {
    "schema": {
      "const": "covenant.timeline.model-proposal-gate.v2"
    },
    "decision": {
      "enum": ["continue", "kill", "inconclusive"]
    },
    "claim": {
      "const": "proposal-interface-reliability"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "failedChecks": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "operationalErrors": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "grounding": {
      "$ref": "#/$defs/grounding"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attemptId",
        "startedAt",
        "resultsArtifactId",
        "resultsPathDigest",
        "sourceRevision",
        "sourceStateDigest",
        "runtimeDigest",
        "corpusDigest",
        "acceptableSupportsDigest",
        "promptDigest",
        "configDigest",
        "resultsDigest",
        "attemptLedgerId",
        "attemptOrdinal",
        "attemptLedgerDigest",
        "authoritative"
      ],
      "properties": {
        "attemptId": {
          "$ref": "#/$defs/uuid"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "resultsArtifactId": {
          "$ref": "#/$defs/uuid"
        },
        "resultsPathDigest": {
          "$ref": "#/$defs/digest"
        },
        "sourceRevision": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sourceStateDigest": {
          "$ref": "#/$defs/digest"
        },
        "runtimeDigest": {
          "$ref": "#/$defs/digest"
        },
        "corpusDigest": {
          "$ref": "#/$defs/digest"
        },
        "acceptableSupportsDigest": {
          "$ref": "#/$defs/digest"
        },
        "promptDigest": {
          "$ref": "#/$defs/digest"
        },
        "configDigest": {
          "$ref": "#/$defs/digest"
        },
        "resultsDigest": {
          "$ref": "#/$defs/digest"
        },
        "attemptLedgerId": {
          "$ref": "#/$defs/uuid"
        },
        "attemptOrdinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "attemptLedgerDigest": {
          "$ref": "#/$defs/digest"
        },
        "authoritative": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "unitInterval": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actual", "requirement", "passed"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "actual": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "requirement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "groundingScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted",
        "predicted",
        "expected",
        "precision",
        "recall",
        "f1"
      ],
      "properties": {
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "predicted": {
          "type": "integer",
          "minimum": 0
        },
        "expected": {
          "type": "integer",
          "minimum": 0
        },
        "precision": {
          "$ref": "#/$defs/unitInterval"
        },
        "recall": {
          "$ref": "#/$defs/unitInterval"
        },
        "f1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "grounding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "repeats"],
      "properties": {
        "overall": {
          "$ref": "#/$defs/groundingScore"
        },
        "repeats": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/groundingScore"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "continue"
          }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "passed": {
                  "const": true
                }
              }
            }
          },
          "failedChecks": {
            "type": "array",
            "maxItems": 0
          },
          "operationalErrors": {
            "type": "array",
            "maxItems": 0
          },
          "bindings": {
            "type": "object",
            "properties": {
              "authoritative": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "kill"
          }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "failedChecks": {
            "type": "array",
            "minItems": 1
          },
          "operationalErrors": {
            "type": "array",
            "maxItems": 0
          },
          "bindings": {
            "type": "object",
            "properties": {
              "authoritative": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "const": "inconclusive"
          }
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "operationalErrors": {
            "type": "array",
            "minItems": 1
          },
          "bindings": {
            "type": "object",
            "properties": {
              "authoritative": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
