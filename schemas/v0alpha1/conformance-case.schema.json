{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://covenant-timeline.org/schemas/v0alpha1/conformance-case.schema.json",
  "title": "Covenant Timeline conformance case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "targetSchema", "requirements", "document", "expect"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]+$"
    },
    "targetSchema": {
      "type": "string",
      "format": "uri-reference"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CTL-[A-Z]+-[0-9]{3}$"
      }
    },
    "document": {
      "type": "object"
    },
    "semanticCheck": {
      "enum": ["duplicate-checkpoints", "required-extensions"]
    },
    "canonicalExpected": {
      "type": "string"
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid"],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "errorCode": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
